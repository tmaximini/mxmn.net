---
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import { useTranslations } from '../../../i18n/utils';

const lang = 'en' as const;
const t = useTranslations(lang);

const services = [
  { id: 'enterprise-platforms', title: t('services.platforms.title'), description: t('services.platforms.description'), detail: t('services.platforms.detail') },
  { id: 'mobile-applications', title: t('services.mobile.title'), description: t('services.mobile.description'), detail: t('services.mobile.detail') },
  { id: 'management-systems', title: t('services.management.title'), description: t('services.management.description'), detail: t('services.management.detail') },
  { id: 'digital-commerce', title: t('services.commerce.title'), description: t('services.commerce.description'), detail: t('services.commerce.detail') },
  { id: 'ai-solutions', title: t('services.ai.title'), description: t('services.ai.description'), detail: t('services.ai.detail') },
  { id: 'integrations-apis', title: t('services.integrations.title'), description: t('services.integrations.description'), detail: t('services.integrations.detail') },
];
---

<Layout lang={lang} title={t('meta.solutions.title')} description={t('meta.solutions.description')} path="/solutions/">
  <Nav lang={lang} />
  <main class="px-6 pt-36 pb-24">
    <div class="max-w-3xl mx-auto">
      <p class="mono-label">{t('services.label')}</p>
      <h1 class="mt-4 font-display text-4xl md:text-6xl font-semibold leading-[1.05] tracking-tight text-ink">
        {t('services.page.title')}
      </h1>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-ink/60">{t('services.page.subtitle')}</p>

      <div class="mt-16 border-t border-ink/10">
        {services.map((s, i) => (
          <section id={s.id} class="scroll-mt-24 border-b border-ink/10 py-10">
            <div class="flex items-baseline gap-6">
              <span class="font-mono text-xs text-accent">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h2 class="font-display text-2xl md:text-3xl font-semibold tracking-tight text-ink">{s.title}</h2>
                <p class="mt-1.5 font-mono text-xs uppercase tracking-[0.14em] text-ink/40">{s.description}</p>
              </div>
            </div>
            <p class="mt-5 pl-12 leading-relaxed text-ink/65">{s.detail}</p>
          </section>
        ))}
      </div>

      <div class="mt-16">
        <a href="/en/#contacto" class="inline-flex px-7 py-3.5 bg-ink text-paper font-medium rounded-full hover:bg-accent transition-colors text-sm">
          {t('services.page.cta')}
        </a>
      </div>
    </div>
  </main>
  <Footer lang={lang} />
</Layout>
